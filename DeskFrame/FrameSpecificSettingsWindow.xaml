<ui:FluentWindow x:Class="DeskFrame.FrameSpecificSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
        xmlns:local="clr-namespace:DeskFrame"
        ExtendsContentIntoTitleBar="True"
        mc:Ignorable="d"    
        Background="#66232323" 
        WindowStyle="None" 
        ResizeMode="NoResize"
        Height="350" 
        Width="450"
        Title="Frame Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Frame Settings" 
                     Name="Titlebar" 
                     Padding="8,0,0,0" 
                     Height="30"  
                     CanMaximize="False" 
                     ShowMinimize="False" 
                     ApplicationTheme="Dark" 
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/ico.png" Margin="0,0,6,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Margin="20,20,20,10">
            <StackPanel>
                <TextBlock Text="This Frame Settings" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,15"
                           Foreground="LightBlue"/>
                
                <!-- Opacity Settings -->
                <TextBlock Text="Frame Opacity" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,0,20">
                    <Slider x:Name="OpacitySlider" 
                            Width="250" 
                            Minimum="0" 
                            Maximum="100" 
                            Value="85"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="OpacitySlider_ValueChanged"/>
                    <TextBlock x:Name="OpacityLabel" 
                               Text="85%" 
                               FontSize="14" 
                               Margin="15,0,0,0" 
                               VerticalAlignment="Center"
                               MinWidth="45"/>
                </StackPanel>

                <!-- Background Color Settings -->
                <TextBlock Text="Background Color" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,0,10">
                    <ui:TextBox x:Name="BackgroundColorTextBox" 
                                Width="180" 
                                PlaceholderText="#AARRGGBB"
                                Text="#0C000000"
                                TextChanged="BackgroundColorTextBox_TextChanged"
                                VerticalAlignment="Center"/>
                    
                    <Border x:Name="ColorPreview" 
                            Width="35" 
                            Height="35" 
                            Margin="10,0,0,0" 
                            Background="#0C000000"
                            BorderBrush="Gray" 
                            BorderThickness="1" 
                            CornerRadius="5"/>
                    
                    <ui:Button Content="Pick" 
                               Margin="10,0,0,0" 
                               Click="PickColorButton_Click"
                               Icon="{ui:SymbolIcon Color24}"/>
                </StackPanel>

                <TextBlock Text="Common colors:" 
                           FontSize="12" 
                           Foreground="Gray" 
                           Margin="0,5,0,5"/>
                
                <WrapPanel Margin="0,0,0,20">
                    <Button Content="Black" 
                            Margin="0,0,5,5" 
                            Padding="10,5" 
                            Click="PresetColor_Click" 
                            Tag="#0C000000"/>
                    <Button Content="Dark Gray" 
                            Margin="0,0,5,5" 
                            Padding="10,5" 
                            Click="PresetColor_Click" 
                            Tag="#0C202020"/>
                    <Button Content="Blue" 
                            Margin="0,0,5,5" 
                            Padding="10,5" 
                            Click="PresetColor_Click" 
                            Tag="#0C001F3F"/>
                    <Button Content="Green" 
                            Margin="0,0,5,5" 
                            Padding="10,5" 
                            Click="PresetColor_Click" 
                            Tag="#0C0F2F1F"/>
                </WrapPanel>

                <Separator Margin="0,10,0,15"/>

                <!-- Preview -->
                <TextBlock Text="Preview" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,10"/>
                
                <Border x:Name="PreviewBorder" 
                        Height="60" 
                        Background="#0C000000" 
                        CornerRadius="8" 
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="Frame Preview" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="This frame only" 
                                   FontSize="11" 
                                   Foreground="LightGray" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="20,10,20,15">
            <ui:Button x:Name="ResetButton" 
                       Content="Reset to Global" 
                       Margin="0,0,10,0" 
                       Click="ResetButton_Click"
                       Icon="{ui:SymbolIcon ArrowReset24}"/>
            <ui:Button x:Name="ApplyButton" 
                       Content="Apply" 
                       Appearance="Primary"
                       Click="ApplyButton_Click"
                       Icon="{ui:SymbolIcon Checkmark24}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
